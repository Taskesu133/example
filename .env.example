# Kopiraj ovaj fajl u .env i popuni

# Anthropic API kljuc (napravi ga na https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Port na kome server slusa
PORT=3000

# Model koji se koristi za odgovore (podrazumevano najkvalitetniji, moze se
# promeniti u jeftiniji zbog troskova - vidi README "Troskovi i cene")
CLAUDE_MODEL=claude-opus-5
