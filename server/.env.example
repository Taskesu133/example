PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret

# Opciono: omoguci AI savete za stednju (bez ovoga aplikacija radi normalno)
DEEPSEEK_API_KEY=

# Opciono: Turso cloud baza (za trajne podatke na besplatnom hostingu poput
# Render-a). Ako se ne postavi, koristi se lokalni SQLite fajl (server/data.sqlite)
# — savrseno za razvoj na svom racunaru.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opciono: automatski uvoz troskova/uplata iz bankovnih mejlova (Yettel Bank)
# preko Gmail-a. Bez ovih promenljivih, funkcija je jednostavno iskljucena.
GMAIL_USER=
GMAIL_APP_PASSWORD=
AUTOMATION_GROUP_NAME=
